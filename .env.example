# ── 서버 공통 ────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://talktalk:CHANGE_ME@127.0.0.1:5432/tanktalk?schema=public
JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM
JWT_EXPIRES_IN_SEC=604800
ADMIN_JWT_EXPIRES_IN_SEC=28800
PUBLIC_BASE_URL=https://api.talktalk.eumsoft.co.kr
CORS_ORIGINS=https://admin.talktalk.eumsoft.co.kr

# Redis(선택): 미설정 시 인메모리 fallback
# REDIS_URL=redis://127.0.0.1:6379

# ── 저장소(비공개) ───────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage
STORAGE_SECRET=CHANGE_ME_STORAGE_SECRET
# S3 호환을 쓸 경우
# STORAGE_DRIVER=s3
# S3_BUCKET=talktalk-private
# S3_REGION=ap-northeast-2
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ── 본인확인/성인인증(운영 필수) ─────────────────────────────
IDENTITY_PROVIDER=NICE
IDENTITY_PROVIDER_API_KEY=
SMS_API_URL=
SMS_API_KEY=

# ── 인앱결제 검증 ────────────────────────────────────────────
IAP_PROVIDER=live
GOOGLE_PLAY_PACKAGE_NAME=co.kr.eumsoft.talktalk
GOOGLE_PLAY_ACCESS_TOKEN=
APPLE_SHARED_SECRET=

# ── 관리자 초기 계정 ─────────────────────────────────────────
ADMIN_BOOTSTRAP_EMAIL=admin@talktalk.eumsoft.co.kr
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
